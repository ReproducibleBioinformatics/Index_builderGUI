# Genome Index Service configuration.
#
# You normally do not write this by hand: run ./setup.sh (or setup.cmd on
# Windows) and it will create .env for you after asking which mode you want and
# where the data should live. Copy this file to .env only if you prefer editing
# it directly.
#
# Every mode reads the same file, and ./gis.sh (gis.cmd) uses GIS_MODE to decide
# what to start.

# Which mode:
#   dind    one privileged container carrying its own Docker (laptop, demo)
#   socket  a normal container using this machine's Docker (recommended on a server)
#   native  a plain process on the machine, no container for the service (Linux/macOS)
GIS_MODE=dind

# Where genomes, indexes, tools, requests and job logs are stored.
# dind accepts a relative path; socket needs an absolute one.
GIS_DATA_DIR=./data

# Interfaces. The admin one has no login, so keep it bound locally unless you
# put your own authenticating proxy in front of it.
GIS_USER_PORT=8000
GIS_ADMIN_PORT=8888
GIS_ADMIN_BIND=127.0.0.1
GIS_USER_BIND=0.0.0.0

# Fallback thread count when a tool declares no "threads" parameter of its own.
INDEX_THREADS=4

# Preferred DNA FASTA flavour, in order. primary_assembly is recommended when it
# exists (it drops haplotype and patch scaffolds); toplevel is the fallback.
DNA_PREFERENCE=primary_assembly,toplevel

# Own the files under the data directory as this user instead of root (Linux).
# Leave empty to skip; permissions are relaxed either way so the files are always
# deletable. Find your values with: id -u   and   id -g
HOST_UID=
HOST_GID=
