# Starting point for a new tool. Edit before adding. No conda/mamba.
# Prefer a tagged release: either a precompiled binary from a GitHub release, or
# compile from the tagged source. The image only needs the tool on PATH; the
# indexing command is supplied at run time.
FROM debian:bookworm-slim
ARG TOOL_VERSION=__VERSION__

# Option A - precompiled binary from a tagged GitHub release:
# ADD https://github.com/ORG/REPO/releases/download/v${TOOL_VERSION}/__TOOL__-linux-x86_64 /usr/local/bin/__TOOL__
# RUN chmod +x /usr/local/bin/__TOOL__ && __TOOL__ --version

# Option B - compile from the tagged source:
