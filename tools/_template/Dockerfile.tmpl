#  && apt-get install -y --no-install-recommends ca-certificates wget make gcc zlib1g-dev \
#  && wget -qO /tmp/src.tar.gz "https://github.com/ORG/REPO/archive/refs/tags/v${TOOL_VERSION}.tar.gz" \
#  && tar -xzf /tmp/src.tar.gz -C /tmp \
#  && make -C /tmp/REPO-${TOOL_VERSION} \
#  && cp /tmp/REPO-${TOOL_VERSION}/__TOOL__ /usr/local/bin/__TOOL__ \
